# Chef AI Workspace — local development defaults (Next.js reads web/.env.local).
# Copy to .env.local and fill the secrets. Never commit .env.local.

# Backend origin for /api/* proxy (loopback only is trusted for FASTAPI_BASE_URL).
CHEF_FASTAPI_INTERNAL_URL=http://127.0.0.1:8000

# Demo credential (>= 24 chars). MUST equal the backend DEMO_ACCESS_TOKEN.
DEMO_ACCESS_TOKEN=change-me-to-a-24-plus-char-token

# Realtime voice relay (optional). Unset = REST transcription path by design;
# the UI then shows "Realtime voice is not configured" and keeps the draft.
# For local realtime via `uvicorn ... --port 8000`:
# NEXT_PUBLIC_DEMO_WS_URL=ws://127.0.0.1:8000
