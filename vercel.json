{
  "git": {
    "deploymentEnabled": {
      "feat/muse-voice-transcription": false,
      "fix/voice-recipe-retrieval": false,
      "fix/voice-understanding-and-confirmation": false,
      "fix/unified-voice-conversation": false
    }
  },
  "services": {
    "frontend": {
      "root": "web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "CHEF_FASTAPI_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "chef_ai_workspace.deploy_server:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
